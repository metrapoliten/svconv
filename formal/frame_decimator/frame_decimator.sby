# Доказательство: frame_decimator оставляет ровно нужные пиксели. Запуск: make formal
# Глубина — больше двух входных кадров (5×5 пикселей).
[options]
mode prove
depth 60

[engines]
smtbmc yices

[script]
read_verilog -sv -formal frame_decimator.sv
read_verilog -sv -formal frame_decimator_fv.sv
prep -top frame_decimator_fv

[files]
../../rtl/core/frame_decimator.sv
frame_decimator_fv.sv
