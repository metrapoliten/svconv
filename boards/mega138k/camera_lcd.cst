// Ограничения пинов camera_lcd_top (Tang Mega 138K Pro Dock). Все пины — 3,3 В.
// Источники: примеры Sipeed TangMega-138KPro-example (led, key_led, dvp_rgb, rgb_screen), сверены со
// схемой дока TANG_MEGA-138K-Pro_Dock-4071f rev 1.2 (листы FPGA_LCD, FPGA_EXT_CONN.,
// PERIPHERALS); на плате пока не проверены.

// Генератор 50 МГц.
IO_LOC "clk50_i" P16;
IO_PORT "clk50_i" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// Кнопка S1 (активный 0), как key0 в примере Sipeed key_led.
IO_LOC "btn_n_i" F15;
IO_PORT "btn_n_i" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// Камера: модуль OV7670 2×9 на проводах к гнёздам PMOD1 (J24) и PMOD2 (J26) дока (схема дока,
// лист FPGA_EXT_CONN.; банки 4 и 5 — 3,3 В). Нумерация контактов гнезда 2×6 по схеме:
//   1 +3V3   2 +3V3
//   3 GND    4 GND
//   5 IO3    6 IO7
//   7 IO2    8 IO6
//   9 IO1   10 IO5
//  11 IO0   12 IO4
// Где это на доке (по iBOM ревизии 4071d): три гнезда в ряд у верхнего края, правее кнопок S0–S3
// и разъёмов HDMI в левом верхнем углу: J22 (PMOD0), J24 (PMOD1), J26 (PMOD2) слева направо.
// Контакт 1 (квадратная площадка) — справа, в ряду, дальнем от края платы; контакт 2 — рядом с
// ним, ближе к краю; далее 3, 4 и т. д. влево.
// Подключение — по порядку выводов модуля 2×9 (1 3V3, 2 GND, 3 SIOC, 4 SIOD, 5 VSYNC, 6 HREF,
// 7 PCLK, 8 XCLK, 9..16 D7..D0, 17 RESET, 18 PWDN), без исключений: среди
// контактов PMOD1/PMOD2 нет ни тактовых входов (GCLK), ни выводов конфигурации (UG986, корпус
// FPG676A; D25 — VREF, здесь обычный вывод), PCLK идёт по обычной трассировке.
//   PMOD1: 1 3V3, 3 GND, 5 SIOC, 6 SIOD, 7 VSYNC, 8 HREF, 9 PCLK, 10 XCLK, 11 D7, 12 D6
//   PMOD2: 5 D5, 6 D4, 7 D3, 8 D2, 9 D1, 10 D0, 11 RESET, 12 PWDN
// Выводы ПЛИС: PMOD1 5 H14, 6 H15, 7 L17, 8 L18, 9 E25, 10 D25, 11 C24, 12 B24;
//              PMOD2 5 A17, 6 A18, 7 B19, 8 A19, 9 B20, 10 A20, 11 C21, 12 B21.
// SIOC/SIOD — открытый сток с внутренней подтяжкой ПЛИС к 3,3 В (если SCCB не работает — внешние
// 4,7–10 кОм к 3,3 В).
// Камера на проводах одним пучком с одной землёй. Без мер против помех кадры приходили
// рваными и с двоением (наводки по проводам на PCLK); опытом с той же камерой и проводами найдены:
// COM2 = 1x (таблица ov7670_init) — обязательно, плюс гистерезис на PCLK, HREF и VSYNC или XCLK
// с наименьшим током (DRIVE=4; его провод соседний с PCLK) — здесь оба. У GW5A гистерезис —
// только ON/OFF (HIGH не принимается), и на входах LVCMOS он включён по умолчанию; здесь — явно.

// PMOD1.
IO_LOC "cam_scl_io" H14;
IO_PORT "cam_scl_io" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "cam_sda_io" H15;
IO_PORT "cam_sda_io" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "cam_vsync_i" L17;
IO_PORT "cam_vsync_i" IO_TYPE=LVCMOS33 PULL_MODE=NONE HYSTERESIS=ON BANK_VCCIO=3.3;
IO_LOC "cam_href_i" L18;
IO_PORT "cam_href_i" IO_TYPE=LVCMOS33 PULL_MODE=NONE HYSTERESIS=ON BANK_VCCIO=3.3;
IO_LOC "cam_pclk_i" E25;
IO_PORT "cam_pclk_i" IO_TYPE=LVCMOS33 PULL_MODE=NONE HYSTERESIS=ON BANK_VCCIO=3.3;
IO_LOC "cam_xclk_o" D25;
IO_PORT "cam_xclk_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "cam_data_i[7]" C24;
IO_PORT "cam_data_i[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "cam_data_i[6]" B24;
IO_PORT "cam_data_i[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// PMOD2.
IO_LOC "cam_data_i[5]" A17;
IO_PORT "cam_data_i[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "cam_data_i[4]" A18;
IO_PORT "cam_data_i[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "cam_data_i[3]" B19;
IO_PORT "cam_data_i[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "cam_data_i[2]" A19;
IO_PORT "cam_data_i[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "cam_data_i[1]" B20;
IO_PORT "cam_data_i[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "cam_data_i[0]" A20;
IO_PORT "cam_data_i[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "cam_rst_n_o" C21;
IO_PORT "cam_rst_n_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "cam_pwdn_o" B21;
IO_PORT "cam_pwdn_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Дисплей: разъём J20 дока (FPC 40P), r/g/b[5] — R7/G7/B7 панели, r/g/b[0] — R2/G2/B2; младшие
// два бита каждого цвета на доке заземлены (RGB666). DISP — к 3,3 В, подсветка включена по
// умолчанию. Режим DE: HSYNC (H22) и VSYNC (A23) не используются.
IO_LOC "lcd_clk_o" H21;
IO_PORT "lcd_clk_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lcd_de_o" A24;
IO_PORT "lcd_de_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lcd_r_o[5]" H19;
IO_PORT "lcd_r_o[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=24 BANK_VCCIO=3.3;
IO_LOC "lcd_r_o[4]" J19;
IO_PORT "lcd_r_o[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=24 BANK_VCCIO=3.3;
IO_LOC "lcd_r_o[3]" G25;
IO_PORT "lcd_r_o[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=24 BANK_VCCIO=3.3;
IO_LOC "lcd_r_o[2]" H18;
IO_PORT "lcd_r_o[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=24 BANK_VCCIO=3.3;
IO_LOC "lcd_r_o[1]" J18;
IO_PORT "lcd_r_o[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=24 BANK_VCCIO=3.3;
IO_LOC "lcd_r_o[0]" K17;
IO_PORT "lcd_r_o[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=24 BANK_VCCIO=3.3;
IO_LOC "lcd_g_o[5]" J16;
IO_PORT "lcd_g_o[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=24 BANK_VCCIO=3.3;
IO_LOC "lcd_g_o[4]" K15;
IO_PORT "lcd_g_o[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=24 BANK_VCCIO=3.3;
IO_LOC "lcd_g_o[3]" F22;
IO_PORT "lcd_g_o[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=24 BANK_VCCIO=3.3;
IO_LOC "lcd_g_o[2]" G22;
IO_PORT "lcd_g_o[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=24 BANK_VCCIO=3.3;
IO_LOC "lcd_g_o[1]" G21;
IO_PORT "lcd_g_o[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=24 BANK_VCCIO=3.3;
IO_LOC "lcd_g_o[0]" G20;
IO_PORT "lcd_g_o[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=24 BANK_VCCIO=3.3;
IO_LOC "lcd_b_o[5]" F20;
IO_PORT "lcd_b_o[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=24 BANK_VCCIO=3.3;
IO_LOC "lcd_b_o[4]" G19;
IO_PORT "lcd_b_o[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=24 BANK_VCCIO=3.3;
IO_LOC "lcd_b_o[3]" F19;
IO_PORT "lcd_b_o[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=24 BANK_VCCIO=3.3;
IO_LOC "lcd_b_o[2]" F18;
IO_PORT "lcd_b_o[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=24 BANK_VCCIO=3.3;
IO_LOC "lcd_b_o[1]" M17;
IO_PORT "lcd_b_o[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=24 BANK_VCCIO=3.3;
IO_LOC "lcd_b_o[0]" M16;
IO_PORT "lcd_b_o[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=24 BANK_VCCIO=3.3;

// Светодиоды LED0..LED5 (горят при 0), как в примерах Sipeed led и key_led.
IO_LOC "led_n_o[0]" J14;
IO_PORT "led_n_o[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led_n_o[1]" R26;
IO_PORT "led_n_o[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led_n_o[2]" L20;
IO_PORT "led_n_o[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led_n_o[3]" M25;
IO_PORT "led_n_o[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led_n_o[4]" N21;
IO_PORT "led_n_o[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led_n_o[5]" N23;
IO_PORT "led_n_o[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
