// Ограничения пинов camera_lcd_top (Tang Primer 20K + Dock ext-board). Пины — 3,3 В, кроме DIP (1,5 В).
// Камера: разъём 24P дока (схема дока 3713, лист «DVP Carmera») — распиновка OV2640/OV5640,
// питание с дока: AVDD 3,0 В, DOVDD 2,8 В, DVDD 1,5 В. Сигналы камеры согласованы по уровням на
// доке: XCLK — через 74LVC1T45, RESET/PWDN — делители 10K/56K, SIOC/SIOD — ключи 2N7002 с
// подтяжкой 5,1K к 2,8 В на стороне камеры. Перед подключением OV7670 сверить его DVDD (1,8 В).


// Генератор 27 МГц.
IO_LOC "clk27_i" H11;
IO_PORT "clk27_i" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// DIP-переключатели дока DIP2..DIP4 (схема дока 3713, лист «Things»): банк 4 — 1,5 В; включённый
// переключатель подаёт ~1,3 В через 1,5K, выключенный — подтяжка 13K к земле.
// DIP1 подключён к RECONFIG_N (B10) и здесь не используется.
IO_LOC "dip_i[0]" E9;
IO_PORT "dip_i[0]" IO_TYPE=LVCMOS15 PULL_MODE=NONE BANK_VCCIO=1.5;
IO_LOC "dip_i[1]" E8;
IO_PORT "dip_i[1]" IO_TYPE=LVCMOS15 PULL_MODE=NONE BANK_VCCIO=1.5;
IO_LOC "dip_i[2]" T5;
IO_PORT "dip_i[2]" IO_TYPE=LVCMOS15 PULL_MODE=NONE BANK_VCCIO=1.5;

// Камера, DVP-разъём 24P дока (пины — из примеров Sipeed Cam2lcd/Cam2HDMI, сверены со схемой).
// SCCB — открытый сток; на стороне ПЛИС у преобразователя уровня нет подтяжки, поэтому включена
// внутренняя подтяжка ПЛИС (3,3 В, сторона ПЛИС) — без неё линию нельзя читать.
IO_LOC "cam_scl_io" F14;
IO_PORT "cam_scl_io" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "cam_sda_io" F16;
IO_PORT "cam_sda_io" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "cam_pclk_i" F13;
IO_PORT "cam_pclk_i" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "cam_vsync_i" G15;
IO_PORT "cam_vsync_i" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "cam_href_i" G14;
IO_PORT "cam_href_i" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "cam_data_i[0]" T12;
IO_PORT "cam_data_i[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "cam_data_i[1]" T11;
IO_PORT "cam_data_i[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "cam_data_i[2]" P11;
IO_PORT "cam_data_i[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "cam_data_i[3]" R11;
IO_PORT "cam_data_i[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "cam_data_i[4]" M15;
IO_PORT "cam_data_i[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "cam_data_i[5]" M14;
IO_PORT "cam_data_i[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "cam_data_i[6]" J16;
IO_PORT "cam_data_i[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "cam_data_i[7]" J14;
IO_PORT "cam_data_i[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "cam_xclk_o" G12;
IO_PORT "cam_xclk_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "cam_rst_n_o" L13;
IO_PORT "cam_rst_n_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "cam_pwdn_o" C10;
IO_PORT "cam_pwdn_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// RGB-LCD, разъём 40P дока (пины — из примеров Sipeed RGB_lcd).
IO_LOC "lcd_clk_o" R9;
IO_PORT "lcd_clk_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lcd_hsync_o" A15;
IO_PORT "lcd_hsync_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lcd_vsync_o" D14;
IO_PORT "lcd_vsync_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lcd_de_o" E15;
IO_PORT "lcd_de_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lcd_r_o[0]" L9;
IO_PORT "lcd_r_o[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lcd_r_o[1]" N8;
IO_PORT "lcd_r_o[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lcd_r_o[2]" N9;
IO_PORT "lcd_r_o[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lcd_r_o[3]" N7;
IO_PORT "lcd_r_o[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lcd_r_o[4]" N6;
IO_PORT "lcd_r_o[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lcd_g_o[0]" D11;
IO_PORT "lcd_g_o[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lcd_g_o[1]" A11;
IO_PORT "lcd_g_o[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lcd_g_o[2]" B11;
IO_PORT "lcd_g_o[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lcd_g_o[3]" P7;
IO_PORT "lcd_g_o[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lcd_g_o[4]" R7;
IO_PORT "lcd_g_o[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lcd_g_o[5]" D10;
IO_PORT "lcd_g_o[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lcd_b_o[0]" B12;
IO_PORT "lcd_b_o[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lcd_b_o[1]" C12;
IO_PORT "lcd_b_o[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lcd_b_o[2]" B13;
IO_PORT "lcd_b_o[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lcd_b_o[3]" A14;
IO_PORT "lcd_b_o[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lcd_b_o[4]" B14;
IO_PORT "lcd_b_o[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Светодиоды дока по шелкографии: LED2 — N16, LED3 — N14, LED4 — L14, LED5 — L16 (горят при 0).
IO_LOC "led_n_o[0]" N16;
IO_PORT "led_n_o[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led_n_o[1]" N14;
IO_PORT "led_n_o[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led_n_o[2]" L14;
IO_PORT "led_n_o[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led_n_o[3]" L16;
IO_PORT "led_n_o[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
