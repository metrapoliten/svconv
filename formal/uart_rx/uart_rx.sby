# Полное доказательство (k-индукция): при любых байтах и паузах uart_rx принимает ровно то, что
# передаёт uart_tx. Запуск: make formal. Обёртка ссылается на внутренние регистры модулей,
# поэтому исходники читает фронтенд read_slang (есть и в нативном yosys, и в YoWASP; в YoWASP
# нет потоков, отсюда --threads 1). Ошибки кадра, помехи и отклонение скорости проверяет
# tests/uart_rx.
[options]
mode prove
depth 90

[engines]
smtbmc yices

[script]
read_slang --threads 1 --top uart_rx_fv uart_tx.sv uart_rx.sv level_sync.sv uart_rx_fv.sv
prep -top uart_rx_fv

[files]
../../rtl/util/uart_tx.sv
../../rtl/util/uart_rx.sv
../../rtl/util/level_sync.sv
uart_rx_fv.sv
