# Доказательство capture_ctrl (k-индукция) с двумя независимыми тактовыми сигналами, которые
# могут останавливаться: см. capture_ctrl_fv.sv. Запуск: make formal (секунды). Для индукции
# хватает глубины 4 (инварианты в обёртке); 30 — чтобы базовый шаг покрывал целый захват (done
# достижим с шага 23) и ошибка давала трассу.
[options]
mode prove
depth 30
multiclock on

[engines]
smtbmc yices

[script]
read_slang --threads 1 --top capture_ctrl_fv level_sync.sv capture_ctrl.sv capture_ctrl_fv.sv
prep -top capture_ctrl_fv

[files]
../../rtl/util/level_sync.sv
../../rtl/bench/capture_ctrl.sv
capture_ctrl_fv.sv
