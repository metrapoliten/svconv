# Доказательство: тайминги video_timing соответствуют параметрам. Запуск: make formal
# Глубина — больше двух кадров (20 тактов): число строк проверяется на втором начале кадра.
[options]
mode prove
depth 80

[engines]
smtbmc yices

[script]
read_verilog -sv -formal video_timing.sv
read_verilog -sv -formal video_timing_fv.sv
prep -top video_timing_fv

[files]
../../rtl/video/video_timing.sv
video_timing_fv.sv
